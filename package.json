{
  "name": "cognitive-ide",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Cognitive IDE - 项目认知图谱驱动的开发环境",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd services/api-server && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}