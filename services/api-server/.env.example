# Cognitive IDE API Server — Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=Cognitive IDE
APP_VERSION=0.1.0-alpha
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database — PostgreSQL
DATABASE_URL=postgresql+asyncpg://cogide:cogide@localhost:5432/cognitive_ide

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Project storage
PROJECTS_ROOT=/tmp/cognitive-ide/projects

# AI — OpenAI compatible (also works with DeepSeek, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI — Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Graph Engine
GRAPH_MAX_DEPTH=5

# Analysis
TREE_SITTER_LANGUAGES=["typescript","python"]